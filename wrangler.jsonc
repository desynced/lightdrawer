// LightDrawer receipts: Workers + Static Assets.
// Template for self-hosters. Production deploy uses gitignored wrangler.production.jsonc:
//   wrangler deploy -c wrangler.production.jsonc
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lightdrawer",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // /api/* and /r/* are dynamic. "/" runs first so /?digest=<hex> can 302 to /r/<hex>.
    // Everything else is served straight from static assets.
    "run_worker_first": ["/api/*", "/r", "/r/*", "/"]
  },
  "vars": {
    // Turnstile site key is NOT listed here — do not commit a real value.
    // Preferred: printf '%s' '<site-key>' | wrangler secret put TURNSTILE_SITE_KEY
    // Or add "TURNSTILE_SITE_KEY" only in a private deploy config (e.g. wrangler.production.jsonc).
    // Matching verifier secret: wrangler secret put TURNSTILE_SECRET
    // Until TURNSTILE_SECRET is set, /api/stamp skips the human check (local/dev).
    // GET /api/config returns the site key at runtime so static files never hard-code it.
    // Staging ACME by default. Production requires CT_PRODUCTION=1 and a production directory.
    "ACME_DIRECTORY": "https://acme-staging-v02.api.letsencrypt.org/directory",
    "CT_HOSTNAME_SUFFIX": "ct.lightdrawer.org",
    "CT_SUB_BATCH_MS": "900000",
    "CT_ANCHOR_EVERY_MS": "21600000",
    "CT_MAX_SANS": "100",
    // Open MCP stamp lane (POST /api/mcp/stamp). "off" until the operator opts in.
    // Turn it on only in a private deploy config, together with the caps below.
    "MCP_LANE": "off",
    // Recommended for a public open lane, or set a smaller number.
    // 20 = stamps per hashed IP per UTC hour. 500 = stamps per UTC day, whole lane.
    // "0" turns that one cap off. Use 0 only as a deliberate operator choice.
    // A cap that is off writes no counter row. Missing or invalid values fall
    // back to these same numbers in code.
    "MCP_LIMIT_IP_HOUR": "20",
    "MCP_LIMIT_GLOBAL_DAY": "500",
    // Warn once per UTC minute, per Worker isolate, when open-lane HTTP 429s
    // go above this count. 0 turns the warning off. It is a log line only.
    "MCP_ALARM_429_PER_MIN": "20",
    // Same-digest upstream cooldown for /api/stamp and /api/mcp/stamp (milliseconds).
    // Within this window a repeat of the same SHA-256 reuses cached calendar payloads
    // instead of calling OpenTimestamps again. A cached stamp with no TSR still calls
    // FreeTSA when the request includes tsq. 0 turns the cooldown off.
    "STAMP_DEDUP_MS": "3600000"
  },
  "d1_databases": [
    {
      "binding": "CT_DB",
      "database_name": "lightdrawer-ct",
      // Replace with your own: wrangler d1 create lightdrawer-ct
      "database_id": "<your-d1-database-id>",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  // Per-location, approximate limits (Workers Rate Limiting binding). Pair with a WAF
  // rate-limiting rule on /api/* for a hard edge cap; see README.
  // MCP_STAMP_LIMITER is 5 requests / 10 seconds per address per location. The
  // open lane returns HTTP 503 if this binding is missing. /api/stamp still
  // allows the request when its own limiter binding is missing (local dev).
  "ratelimits": [
    { "name": "STAMP_LIMITER", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "STAMP_AUTH_LIMITER", "namespace_id": "4103", "simple": { "limit": 20, "period": 60 } },
    { "name": "UPGRADE_LIMITER", "namespace_id": "4102", "simple": { "limit": 60, "period": 60 } },
    { "name": "MCP_STAMP_LIMITER", "namespace_id": "4104", "simple": { "limit": 5, "period": 10 } }
  ],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  // Add custom-domain routes when you want the Worker on your own domain, e.g.:
  // "routes": [
  //   { "pattern": "example.com", "custom_domain": true },
  //   { "pattern": "www.example.com", "custom_domain": true }
  // ],
  "workers_dev": true,
  "send_metrics": false
}
